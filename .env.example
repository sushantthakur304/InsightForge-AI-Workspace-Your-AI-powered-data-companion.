INSIGHTFORGE_MAX_UPLOAD_MB=100
INSIGHTFORGE_MASK_SENSITIVE_PREVIEWS=true
INSIGHTFORGE_AI_PROVIDER=rule_based
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
INSIGHTFORGE_STORAGE_DB=data/insightforge_storage.sqlite3
INSIGHTFORGE_STORAGE_DIR=data/datasets

# Production: set these only in your deployment's secret manager.
# INSIGHTFORGE_STORAGE_BACKEND=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
# INSIGHTFORGE_SUPABASE_BUCKET=dataset-files
# INSIGHTFORGE_BACKGROUND_FILE_THRESHOLD_MB=25
# INSIGHTFORGE_REFERENCE_CHECKS_JSON=[{"label":"Approved country codes","url":"https://example.com/countries.json","column":"country_code","items_path":"data","value_field":"code"}]
